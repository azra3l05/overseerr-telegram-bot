# ============================================================
# Overseerr Telegram Bot — Configuration
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file.
# ============================================================

# --- Telegram (required) ---
TELEGRAM_BOT_TOKEN=your_bot_token_here          # get one from @BotFather

# --- Overseerr (required) ---
OVERSEERR_API_URL=https://overseerr.example.com/api/v1
OVERSEERR_API_KEY=your_overseerr_api_key_here
# A valid Overseerr user the bot authenticates as to submit requests:
TELEGRAMBOT_USERNAME=your_overseerr_email@example.com
TELEGRAMBOT_PASSWORD=your_overseerr_password

# --- Libraries (required: routes requests to the right root folder) ---
# Format: "Name:RootFolderID,Name:RootFolderID"
# Find IDs from Radarr/Sonarr:  GET /api/v3/rootfolder
LIBRARIES_MOVIES=Movies:1,Anime Movies:2
LIBRARIES_TV=TV Shows:3,Anime:4

# --- TMDB (optional: better search & recommendations) ---
TMDB_API_KEY=your_tmdb_api_key_here

# --- Radarr / Sonarr (optional: real-time availability checks) ---
RADARR_API_URL=http://radarr:7878
RADARR_API_KEY=your_radarr_api_key_here
SONARR_API_URL=http://sonarr:8989
SONARR_API_KEY=your_sonarr_api_key_here

# --- PostgreSQL (optional: direct availability + request logging) ---
# Leave POSTGRES_ENABLED=false to rely solely on the Overseerr API.
POSTGRES_ENABLED=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=overseerr
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_SCHEMA=public

# --- Discord alerts / companion bot (optional) ---
DISCORD_ALERTS_WEBHOOK=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# --- Admin (optional: comma-separated Telegram user IDs) ---
ADMIN_USER_IDS=

# --- Paths & logging (optional: sensible defaults shown) ---
LOG_DIR=logs
LOG_LEVEL=INFO
DATA_DIR=data

# --- Behaviour tuning (optional) ---
AVAILABILITY_CHECK_INTERVAL=15     # minutes
MESSAGE_DELETE_TIMEOUT=3           # seconds
CONFIRMATION_DELETE_TIMEOUT=6      # seconds
HEALTH_CHECK_PORT=9090
